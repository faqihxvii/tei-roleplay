{
  "name": "the-economic-influence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run room:build",
    "start": "npm run room:start",
    "clean": "rm -rf dist",
    "lint": "npm run typecheck && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test engine/test/*.test.ts room/test/*.test.ts web/test/*.test.ts",
    "sim": "tsx engine/sim/run.ts",
    "print-kit": "tsx engine/print/build.ts",
    "room": "tsx watch room/src/main.ts",
    "room:web": "vite --config web/vite.config.ts",
    "room:build": "vite build --config web/vite.config.ts && esbuild room/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/room.mjs",
    "room:start": "NODE_ENV=production node dist/room.mjs",
    "room:e2e": "node web/e2e/full-game.mjs",
    "art:build": "tsx web/art/build.ts",
    "audio:build": "tsx web/audio/build.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "express": "^5.2.1",
    "howler": "^2.2.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.3"
  }
}
